# Cloudflare Pages headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self'; manifest-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite emits content-hashed files under /assets, cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# brand images and icons, stable, revalidate daily
/og.png
  Cache-Control: public, max-age=86400
/logo.png
  Cache-Control: public, max-age=86400
/logo.svg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400

# service worker must always revalidate so updates roll out
/sw.js
  Cache-Control: no-cache
