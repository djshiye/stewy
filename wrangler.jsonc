// Cloudflare Workers static assets: the built app in dist/, served as a single-page app.
// public/_headers carries over (Workers assets read _headers and _redirects like Pages).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stewy",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
